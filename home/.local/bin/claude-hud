#!/bin/bash
# Claude Code statusLine entry point. Prefers the Python renderer (plugin + status line +
# gauges, see claude-hud.py); without python3 it falls back to the bare claude-hud plugin.
here="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
if command -v python3 >/dev/null 2>&1 && [ -f "$here/claude-hud.py" ]; then
  exec python3 "$here/claude-hud.py"
fi
dir=$(ls -d "$HOME"/.claude/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | sort -V | tail -1)
[ -n "$dir" ] && exec node "${dir}dist/index.js"
cat >/dev/null; echo "claude-hud plugin not found"
